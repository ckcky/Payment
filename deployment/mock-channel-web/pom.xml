<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        mock-channel-web（ADR-0048 修订版，2026-08-31 负责人裁决）：Mock 渠道收银台 + 演示控制台。

        定位：演示组件，非领域服务 —— 故不进入 architecture-tests 的 ServiceBoundaryTest.SERVICES
        数组（纳入只增噪音）。它不依赖任何服务模块、不持有业务数据、不做资金操作：
          · 收银台页（/cashier）：以"渠道"身份向 payment-service 发签名回调（含伪造签名演示）；
          · 演示控制台（/demo）：同源代理（/proxy/**）转发到各服务，避免 CORS；
          · 全链路 DB 诊断（/demo/trace）：只读直连 MySQL 实例，按订单跨库查各系统落库记录
            （database-per-service 共实例，见 deployment/schema/*.sql；只 SELECT，不写任何表）；
          · 唯一共享依赖是 common-core 的 SignatureVerifier（与 payment-service 同一验签实现）。
    -->
    <parent>
        <groupId>com.payment</groupId>
        <artifactId>payment-arch</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <!-- 本模块收口在 deployment/ 下，需上溯两级到仓库根 -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>mock-channel-web</artifactId>
    <name>mock-channel-web</name>
    <description>Mock 渠道收银台与演示控制台（端口 8091，演示组件非领域服务）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 健康检查 + Prometheus 指标（与其他服务口径一致，便于纳入同一套 Grafana） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 指标注册表：application.yml 暴露了 prometheus 端点、prometheus.yml 也配了抓取，
             但缺此依赖时 /actuator/prometheus 一律 500，该抓取目标恒为 DOWN。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- 仅用 SignatureVerifier（HMAC-SHA256），与 payment-service 验签同一实现 -->
        <dependency>
            <groupId>com.payment</groupId>
            <artifactId>common-core</artifactId>
        </dependency>

        <!-- 全链路 DB 诊断（/demo/trace）：只读 JDBC 直查共实例 MySQL 的各库落库记录 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
