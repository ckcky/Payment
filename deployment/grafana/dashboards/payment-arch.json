            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "5xx 为服务端错误；4xx 为客户端错误（含限流 429）"
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "错误请求速率 (4xx / 5xx, req/s)",
      "datasource": {
