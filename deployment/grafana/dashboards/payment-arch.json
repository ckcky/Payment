    {
      "id": 41,
      "type": "timeseries",
      "title": "HikariCP 连接池 (各服务)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (service_cn) (hikaricp_connections_active)",
          "refId": "A",
          "legendFormat": "活跃 {{service_cn}}"
        },
        {
          "expr": "sum by (service_cn) (hikaricp_connections_idle)",
          "refId": "B",
          "legendFormat": "空闲 {{service_cn}}"
        },
        {
          "expr": "sum by (service_cn) (hikaricp_connections_pending)",
          "refId": "C",
          "legendFormat": "等待 {{service_cn}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "pending > 0 表示连接池打满（饱和前兆）"
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "JVM 堆内存使用 (各服务)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (service_cn) (jvm_memory_used_bytes{area=\"heap\"})",
