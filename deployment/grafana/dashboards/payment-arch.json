{
  "uid": "payment-arch",
  "title": "PaymentArch监控大盘",
  "description": "Google SRE 四大黄金信号（延迟 / 流量 / 错误 / 饱和度）+ 服务间 RPC（Feign）+ 业务指标。耗时统一毫秒 (ms)，服务图例均为中文名（service_cn）。",
  "tags": [
    "payment-arch",
    "sre-golden-signals"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "总览",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "流量 · 全局 QPS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "延迟 · P99 (全服务)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m]))) * 1000",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "全服务聚合 P99，毫秒"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "错误 · 5xx 错误率 (全服务)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "服务端错误占比，SLO 通常 < 1%"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "饱和度 · HikariCP 活跃连接",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_active)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "数据库连接池活跃连接数（跨服务求和）"
    },
    {
      "id": 10,
      "type": "row",
      "title": "① 延迟 Latency（毫秒）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP 延迟分位 P50 / P95 / P99 (全服务, ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket[5m]))) * 1000",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m]))) * 1000",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m]))) * 1000",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "description": "基于 http_server_requests（Prometheus 直方图），×1000 统一为毫秒"
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "P99 延迟 (各服务, ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service_cn) (rate(http_server_requests_seconds_bucket[5m]))) * 1000",
          "refId": "A",
          "legendFormat": "{{service_cn}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "description": "定位慢服务"
    },
    {
      "id": 20,
      "type": "row",
      "title": "② 流量 Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "HTTP 请求速率 (各服务, req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "sum by (service_cn) (rate(http_server_requests_seconds_count[1m]))",
          "refId": "A",
          "legendFormat": "{{service_cn}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "业务流转速率 (5m 增量)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(order_initiated_total[5m]))",
          "legendFormat": "下单"
        },
        {
          "expr": "sum(increase(payment_initiated_total{module=\"payment\"}[5m]))",
          "refId": "A",
          "legendFormat": "支付创建"
        },
        {
          "expr": "sum(increase(payment_succeeded_total{module=\"payment\"}[5m]))",
          "refId": "B",
          "legendFormat": "支付成功"
        },
        {
          "expr": "sum(increase(refund_initiated_total{module=\"refund\"}[5m]))",
          "refId": "C",
          "legendFormat": "退款发起"
        },
        {
          "expr": "sum(increase(refund_succeeded_total{module=\"refund\"}[5m]))",
          "refId": "D",
          "legendFormat": "退款成功"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "③ 错误 Errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "HTTP 错误率 (各服务, %)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "100 * sum by (service_cn) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (service_cn) (rate(http_server_requests_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "5xx {{service_cn}}"
        },
        {
          "expr": "100 * sum by (service_cn) (rate(http_server_requests_seconds_count{status=~\"4..\"}[5m])) / sum by (service_cn) (rate(http_server_requests_seconds_count[5m]))",
          "refId": "B",
          "legendFormat": "4xx {{service_cn}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "5xx 为服务端错误；4xx 为客户端错误（含限流 429）"
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "错误请求速率 (4xx / 5xx, req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "refId": "A",
          "legendFormat": "5xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..\"}[1m]))",
          "refId": "B",
          "legendFormat": "4xx"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "④ 饱和度 Saturation",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "HikariCP 连接池 (各服务)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (service_cn) (hikaricp_connections_active)",
          "refId": "A",
          "legendFormat": "活跃 {{service_cn}}"
        },
        {
          "expr": "sum by (service_cn) (hikaricp_connections_idle)",
          "refId": "B",
          "legendFormat": "空闲 {{service_cn}}"
        },
        {
          "expr": "sum by (service_cn) (hikaricp_connections_pending)",
          "refId": "C",
          "legendFormat": "等待 {{service_cn}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "pending > 0 表示连接池打满（饱和前兆）"
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "JVM 堆内存使用 (各服务)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (service_cn) (jvm_memory_used_bytes{area=\"heap\"})",
          "refId": "A",
          "legendFormat": "{{service_cn}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "进程 CPU 使用率 (各服务)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum by (service_cn) (process_cpu_usage) * 100",
          "refId": "A",
          "legendFormat": "{{service_cn}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 70,
      "type": "row",
      "title": "⑤ 服务间调用 RPC（Feign，调用方 → 目标服务）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "id": 71,
      "type": "timeseries",
      "title": "RPC 调用速率 (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 42
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service_cn, rpc_cn) (label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(rate(http_client_requests_seconds_count[1m]), \"rpc_cn\", \"其他\", \"clientName\", \".*\"), \"rpc_cn\", \"商品服务\", \"clientName\", \".*CatalogFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*PaymentFactsFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*RefundFactsFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*PaymentFeignClient\"), \"rpc_cn\", \"履约服务\", \"clientName\", \".*FulfillmentFeignClient\"), \"rpc_cn\", \"订单服务\", \"clientName\", \".*OrderFeignClient\"), \"rpc_cn\", \"账务服务\", \"clientName\", \".*LedgerFeignClient\"), \"rpc_cn\", \"权益服务\", \"clientName\", \".*EntitlementFeignClient\"), \"rpc_cn\", \"商户服务\", \"clientName\", \".*MerchantFeignClient\"), \"rpc_cn\", \"对账服务\", \"clientName\", \".*ReconciliationFeignClient\"))",
          "refId": "A",
          "legendFormat": "{{service_cn}} → {{rpc_cn}}"
        }
      ],
      "description": "Feign 客户端指标 http.client.requests（feign-micrometer）。rpc_cn 已映射为中文目标服务名。"
    },
    {
      "id": 72,
      "type": "timeseries",
      "title": "RPC 延迟 P95 / P99 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 42
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, rpc_cn) (label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(rate(http_client_requests_seconds_bucket[5m]), \"rpc_cn\", \"其他\", \"clientName\", \".*\"), \"rpc_cn\", \"商品服务\", \"clientName\", \".*CatalogFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*PaymentFactsFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*RefundFactsFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*PaymentFeignClient\"), \"rpc_cn\", \"履约服务\", \"clientName\", \".*FulfillmentFeignClient\"), \"rpc_cn\", \"订单服务\", \"clientName\", \".*OrderFeignClient\"), \"rpc_cn\", \"账务服务\", \"clientName\", \".*LedgerFeignClient\"), \"rpc_cn\", \"权益服务\", \"clientName\", \".*EntitlementFeignClient\"), \"rpc_cn\", \"商户服务\", \"clientName\", \".*MerchantFeignClient\"), \"rpc_cn\", \"对账服务\", \"clientName\", \".*ReconciliationFeignClient\"))) * 1000",
          "refId": "A",
          "legendFormat": "{{rpc_cn}} p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, rpc_cn) (label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(rate(http_client_requests_seconds_bucket[5m]), \"rpc_cn\", \"其他\", \"clientName\", \".*\"), \"rpc_cn\", \"商品服务\", \"clientName\", \".*CatalogFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*PaymentFactsFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*RefundFactsFeignClient\"), \"rpc_cn\", \"支付服务\", \"clientName\", \".*PaymentFeignClient\"), \"rpc_cn\", \"履约服务\", \"clientName\", \".*FulfillmentFeignClient\"), \"rpc_cn\", \"订单服务\", \"clientName\", \".*OrderFeignClient\"), \"rpc_cn\", \"账务服务\", \"clientName\", \".*LedgerFeignClient\"), \"rpc_cn\", \"权益服务\", \"clientName\", \".*EntitlementFeignClient\"), \"rpc_cn\", \"商户服务\", \"clientName\", \".*MerchantFeignClient\"), \"rpc_cn\", \"对账服务\", \"clientName\", \".*ReconciliationFeignClient\"))) * 1000",
          "refId": "B",
          "legendFormat": "{{rpc_cn}} p99"
        }
      ],
      "description": "依赖 management.metrics.distribution.percentiles-histogram.http.client.requests=true（已在 5 个 Feign 调用方开启）"
    },
    {
      "id": 73,
      "type": "timeseries",
