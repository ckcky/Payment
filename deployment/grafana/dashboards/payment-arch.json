    {
      "id": 22,
      "type": "timeseries",
      "title": "业务流转速率 (5m 增量)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(order_initiated_total[5m]))",
          "legendFormat": "下单"
        },
        {
          "expr": "sum(increase(payment_initiated_total{module=\"payment\"}[5m]))",
          "refId": "A",
          "legendFormat": "支付创建"
        },
        {
          "expr": "sum(increase(payment_succeeded_total{module=\"payment\"}[5m]))",
          "refId": "B",
          "legendFormat": "支付成功"
        },
        {
          "expr": "sum(increase(refund_initiated_total{module=\"refund\"}[5m]))",
          "refId": "C",
          "legendFormat": "退款发起"
        },
        {
          "expr": "sum(increase(refund_succeeded_total{module=\"refund\"}[5m]))",
          "refId": "D",
          "legendFormat": "退款成功"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "③ 错误 Errors",
