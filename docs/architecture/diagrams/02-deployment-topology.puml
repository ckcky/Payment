@startuml
' PaymentArch 单机部署拓扑图
' 渲染：plantuml.jar -tsvg -o _render 02-deployment-topology.puml
' 警告：PlantUML 默认输出同名 .svg，会直接覆盖文档展示用的手绘图！务必用 -o 指定输出目录
' 布局：无 Graphviz 时用 Smetana；已装 Graphviz 后可删掉下行 pragma，改用 dot 渲染（布局更规整）
!pragma layout smetana

title PaymentArch 单机部署拓扑

skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam ArrowColor #6B6B6B
skinparam ArrowThickness 1
skinparam ArrowFontSize 11
skinparam Padding 4
skinparam Linetype ortho

skinparam node {
  BorderColor #B4B2A9
  BackgroundColor #FAFAF8
  FontSize 13
  FontStyle bold
  BorderThickness 1
}

skinparam rectangle {
  BorderThickness 1
  FontSize 12
}

skinparam database {
  BorderColor #B4B2A9
  BackgroundColor #E1F5EE
}

node "宿主机 · 10 个独立 JVM 进程" as HOST {
  rectangle "无 Dockerfile，未容器化" as TAG #F1EFE8
  rectangle "8081 merchant · 8082 catalog · 8083 order · 8084 payment · 8086 fulfillment" as ROW1
  rectangle "8087 entitlement · 8088 reconciliation · 8089 settlement · 8090 ledger · 8091 mock-channel-web" as ROW2
}

node "Docker Compose · 基础设施容器" as DOCKER {
  database "MySQL 8.0\n3306 · 9 个独立 Schema，卷持久化" as MySQL
  rectangle "Prometheus\n9090 · 抓取宿主 8081–8091 指标" as Prom #D7E9F5
  rectangle "Grafana\n3000 · 内置业务指标看板" as Graf #D7E9F5
}

HOST -down-> MySQL : JDBC 3306
Prom -up-> HOST : 经 host.docker.internal 回抓

note right of HOST
  **一键运维**：start-all.sh / stop-all.sh
  日志落 deployment/logs/[service].log
  每服务暴露 Swagger UI、/actuator/health、/actuator/prometheus
end note

@enduml
