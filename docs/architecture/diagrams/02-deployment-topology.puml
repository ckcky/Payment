@startuml
' PaymentArch 单机部署拓扑图（双模式：容器模式 / 宿主模式）
' 渲染：plantuml.jar -tsvg -o _render 02-deployment-topology.puml
' 警告：PlantUML 默认输出同名 .svg，会直接覆盖文档展示用的手绘图！务必用 -o 指定输出目录
' 布局：无 Graphviz 时用 Smetana；已装 Graphviz 后可删掉下行 pragma，改用 dot 渲染（布局更规整）
!pragma layout smetana

title PaymentArch 单机部署拓扑（双模式 · 二选一）

skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam ArrowColor #6B6B6B
skinparam ArrowThickness 1
skinparam ArrowFontSize 11
skinparam Padding 4
skinparam Linetype ortho

skinparam node {
  BorderColor #B4B2A9
  BackgroundColor #FAFAF8
  FontSize 13
  FontStyle bold
  BorderThickness 1
}

skinparam rectangle {
  BorderThickness 1
  FontSize 12
}

skinparam database {
  BorderColor #B4B2A9
  BackgroundColor #E1F5EE
}

' ============ 容器模式（spec 026 / ADR-0070，推荐）============
node "容器模式 · Docker Compose --profile full" as FULL {
  node "应用容器（10 个 · paymentarch/*:local）" as APPS {
    rectangle "8081 merchant · 8082 catalog · 8083 order · 8084 payment" as ROW1 #E6F1FB
    rectangle "8086 fulfillment · 8087 entitlement · 8088 reconciliation" as ROW2 #E6F1FB
    rectangle "8089 settlement · 8090 ledger · 8091 mock-channel-web" as ROW3 #E6F1FB
  }
  rectangle "镜像：宿主打 fat jar → Dockerfile 只 COPY\n基础镜像 eclipse-temurin:21-jre-jammy" as IMG #F1EFE8
}

' ============ 宿主模式（保留，用于调试）============
node "宿主模式 · 宿主 JVM 进程" as HOST {
  rectangle "IDE 断点调试 / 改码热重启路径" as TAG #F1EFE8
  rectangle "8081 merchant · 8082 catalog · 8083 order · 8084 payment" as HROW1 #FAEEDA
  rectangle "8086 fulfillment · 8087 entitlement · 8088 reconciliation" as HROW2 #FAEEDA
  rectangle "8089 settlement · 8090 ledger · 8091 mock-channel-web" as HROW3 #FAEEDA
}

' ============ 基础设施（两种模式共用）============
node "Docker Compose · 基础设施容器（两种模式共用）" as DOCKER {
  database "MySQL 8.0\n3306 · 8 个独立 Schema，卷持久化" as MySQL
  database "Redis 7\n6379 · 非数据源（fail-open）" as Redis
  rectangle "Nacos 3.0.3\n8848/9848/9849 · 注册中心（ADR-0059 硬依赖）" as Nacos #D7E9F5
  rectangle "Prometheus\n9090 · 抓取 10 个服务 /actuator/prometheus" as Prom #D7E9F5
  rectangle "Grafana\n3000 · 内置业务指标看板" as Graf #D7E9F5
  rectangle "Loki + Promtail\n3100 · 日志聚合（共用 ./logs 卷）" as Loki #D7E9F5
}

APPS -down-> MySQL : JDBC 3306
APPS -down-> Nacos : 注册与发现
HOST -down-> MySQL : JDBC 3306
HOST -down-> Nacos : 注册与发现
Prom -up-> APPS : 容器模式：按服务名抓取
Prom -up-> HOST : 宿主模式：host.docker.internal

note right of FULL
  **入口**：start-container.sh
  **构建**：build-images.sh（jar → 镜像）
  depends_on nacos: service_healthy
  端口 8081–8091 与宿主模式**互斥**
end note

note right of HOST
  **入口**：start-all.sh
  日志落 deployment/logs/[service].log
  需 JDK 17+（RunMojo 要求），容器模式无此约束
end note

note bottom of DOCKER
  两种模式共用同一份 compose：
  --profile infra 只起中间件（宿主模式用）
  --profile full 起全栈（容器模式用）
end note

@enduml
