@startuml
' PaymentArch · 03 Payment Components（C4 Level 3 —— 仅 payment-service）
' SOURCE OF TRUTH = 本 .puml；同目录 03-payment-components.svg 为渲染产物，禁止手工编辑。
' 渲染：java -jar deployment/output/tools/plantuml.jar -tsvg -o <目标目录> docs/architecture/diagrams/03-payment-components.puml
' 规范：docs/standards/diagram-standard.md
' 依据：docs/architecture/systems/payment-service.md §1.1 / §2.1.1 / §4（ADR-0072 / 0073 / 0075 / 0076）
!pragma layout smetana
left to right direction

title PaymentArch · L3 Component —— payment-service 内部有架构意义的组件

skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam ArrowColor #6B6B6B
skinparam ArrowThickness 1
skinparam ArrowFontSize 10
skinparam Padding 4
skinparam roundcorner 10

skinparam rectangle<<payment>> {
  BackgroundColor #DCE6F2
  BorderColor #5B7DA8
  BorderThickness 1
  FontSize 11
}
skinparam rectangle<<channel>> {
  BackgroundColor #D7E9F5
  BorderColor #5B7DA8
  BorderThickness 1
  FontSize 11
}
skinparam rectangle<<port>> {
  BackgroundColor #EDEDED
  BorderColor #5B7DA8
  BorderThickness 1
  FontSize 11
}
skinparam rectangle<<ext>> {
  BackgroundColor #E8E8E8
  BorderColor #A0A0A0
  BorderThickness 1
  FontSize 11
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #B4B2A9
  FontSize 12
}

package "api 接入层" as API {
  rectangle "PaymentController\nHTTP 入口 / DTO 转换" as C1 <<payment>>
}

package "application 应用层（payment 支付层）" as APP {
  rectangle "PaymentApplicationService\n支付意图编排 / 选路 / 建单 / 应用结果" as A1 <<payment>>
  rectangle "PaymentPersistence\npayments 表唯一写入口\n（建单 + 结果应用，本地事务）" as A2 <<payment>>
  rectangle "PaymentResultApplier\n双状态机驱动（payment / attempt）" as A3 <<payment>>
  rectangle "PaymentCallbackService\nPaymentUnknownResolutionService\n回调收敛 / UNKNOWN 收敛" as A4 <<payment>>
  rectangle "PaymentRefundService\n退款域（原 refund-service，ADR-0064）" as A5 <<payment>>
  rectangle "LimitGate\n用户支付限额两阶段预占（spec 027）" as A6 <<payment>>
}

package "application.channel 渠道层端口" as PORTS {
  rectangle "PaymentChannel\n渠道交互端口" as P1 <<port>>
  rectangle "ChannelRouter\n前向选路（确定性，读 channel_code 枚举）" as P2 <<port>>
  rectangle "ChannelRegistry\n渠道身份注册表（按 channel_code 解析）" as P3 <<port>>
  rectangle "ChannelAttemptRecorder\npayment_attempts 表唯一写入口" as P4 <<port>>
}

package "application.reliability 可靠性" as REL {
  rectangle "PaymentRetryService\n渠道通信退避重试（同 attempt 重放）" as R1 <<payment>>
  rectangle "TimeoutScanner\nPROCESSING 超时扫描" as R2 <<payment>>
}

package "domain 领域层" as DOM {
  rectangle "Payment（聚合根）\n状态机 / 幂等键 / 金额口径" as D1 <<payment>>
  rectangle "PaymentAttempt（聚合根）\n渠道交互生命周期 / channelMode 派生" as D2 <<channel>>
}

package "infra.channel 渠道实现族" as IMPl {
  rectangle "AbstractMockChannelAdapter\n模板方法：编排 + MOCK 模拟语义" as I1 <<channel>>
  rectangle "MockChannelAdapter / WechatChannelAdapter / DouyinChannelAdapter" as I2 <<channel>>
  rectangle "AlipayChannelAdapter\nsupportsRealMode()=true（SANDBOX）" as I3 <<channel>>
  rectangle "AlipayGateway\n收口 alipay-sdk-java（SDK 不外泄）" as I4 <<channel>>
}

package "infra.persistence 持久化" as IMPP {
  rectangle "MybatisPaymentRepository\n实现 domain 仓储接口（依赖倒置）" as J1 <<payment>>
  rectangle "ChannelAttemptRecorderImpl\n实现 ChannelAttemptRecorder 端口" as J2 <<channel>>
}

rectangle "order-service\n[Container]" as ORD <<ext>>
rectangle "ledger-service\n[Container]" as LED <<ext>>
rectangle "支付宝开放平台（沙箱）\n[External System]" as ALI <<ext>>
database "payments\n（只由 payment 层写）" as DB1
database "payment_attempts\n（只由渠道层写）" as DB2

C1 --> A1 : 调用用例\nJava（进程内）
A1 --> A2 : 建单 / 应用结果\nJava（共享本地事务）
A1 --> P2 : 请求选路\nJava（端口）
A1 --> P4 : 开启 PAYMENT 尝试\nJava（端口）
A1 --> A6 : 预占额度\nJava（端口）
A3 --> D1
A3 --> D2
A4 --> A3 : 复用结果应用
A5 --> P3 : 按原支付尝试解析渠道归属\nJava（端口，禁止重新路由）
R1 --> P1 : 同 attempt 重放\nJava（端口）
R2 --> P1 : 主动查询\nJava（端口）

P2 --> P3 : 取候选渠道
P1 <|.. I1 : 实现（端口 → 实现，infra 依赖 application）
I1 <|-- I2
I1 <|-- I3
I3 --> I4 : 收口 SDK
P4 <|.. J2 : 端口 → 实现（依赖倒置）

I1 --> ALI : 支付指令 / 退款 / 查询\nHTTPS（SANDBOX 走真实协议）
A2 --> DB1 : INSERT / UPDATE
J2 --> DB2 : INSERT / UPDATE
A4 --> ORD : notifyPaymentSucceeded\nFeign RPC
A4 --> LED : postPaymentCapture / 退款冲正\nFeign RPC

legend right
  **Legend**
  蓝灰 = payment 支付层组件 ｜ 浅蓝 = channelAttempt 渠道层组件 ｜ 浅灰 = 端口（interface）｜ 灰 = 外部容器 / 系统
  依赖方向铁律：api → application → domain ← infra；**application 包 MUST NOT 依赖 infra.channel**（ArchUnit INV-4/INV-5）
  连线语义：Primary Flow = Blue ｜ Success = Green ｜ Unknown = Orange ｜ Failure = Red
endlegend

@enduml
